  m_text: "\nOCEAN CLAW\n\n\nTeam Simplay\n\n\n\n\uBE44\uBC84\uB77D\uC2A4 \uD504\uB85C\uC81D\uD2B8\n\n\n\n\uBC14\uB2E4\uC758
