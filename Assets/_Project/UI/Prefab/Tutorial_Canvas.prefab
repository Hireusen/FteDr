--- !u!114 &4556740138039669289
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 6529734431612883377}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 52e003fac18ab314f85eda7438f93417, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  _steps:
  - message: "\uC0C1\uC810\uC740 \uC7A0\uC218\uD568 \uBCBD\uC5D0 \uC788\uB294 \uD328\uB110\uC744
      \uD074\uB9AD\uD558\uC5EC \uC774\uC6A9\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\n\n\uD574\uC800\uB85C
      \uB0B4\uB824\uAC00 \uBB3C\uAC74\uC744 \uC218\uC9D1\uD558\uACE0 \uB3CC\uC544\uC640\uC11C
      \n\uC0C1\uC810\uC5D0 \uD310\uB9E4\uD574\uBCF4\uC138\uC694!"
    illustration: {fileID: 21300000, guid: 9707435d81a2fef478134953eabeb049, type: 3}
  - message: "\uC870\uC885\uC11D\uC744 \uD074\uB9AD\uD558\uACE0 E \uD0A4\uB97C \uB20C\uB800\uC744
      \uB54C \uC7A0\uC218\uD568 \uB808\uBCA8\uC774 \uCDA9\uBD84\uD558\uB2E4\uBA74
      \uB354 \uAE4A\uC740 \uACF3\uC73C\uB85C \uD558\uAC15 \uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\n\n\uBC18\uB300\uB85C
      Q \uD0A4\uB97C \uB204\uB974\uBA74 \uB2E4\uC2DC \uC62C\uB77C\uC62C \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    illustration: {fileID: 21300000, guid: 960b33b8bf2f8c74db4bab7d8f7edcdf, type: 3}
  - message: "\uC67C\uD074\uB9AD\uD558\uC5EC \uC9D1\uAC8C\uB97C \uC9C1\uC120\uC73C\uB85C
      \uBC1C\uC0AC\uD569\uB2C8\uB2E4. \n\uC6B0\uD074\uB9AD\uD558\uC5EC \uC9D1\uAC8C\uB97C
      \uD68C\uC218 \uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4. \n\uB610\uD55C \uBB3C\uAC74\uC744
      \uC798 \uC9D1\uAE30 \uC704\uD574 Q, E \uD0A4\uB85C \uC9D1\uAC8C\uB97C \uD68C\uC804
      \uC2DC\uD0AC\uC218 \uC788\uC2B5\uB2C8\uB2E4!"
    illustration: {fileID: 21300000, guid: 3c69f1c6bf7fe7c4ca2074561c4d7f5f, type: 3}
  - message: "HUD\uB97C \uD1B5\uD574 \uAC00\uBC29\uC740 TAB \uD0A4, \n\uADF8\uBB3C\uC740
      C \uD0A4\uB85C \uC870\uC791\uC774 \uAC00\uB2A5\uD569\uB2C8\uB2E4.\n\nH \uD0A4\uB97C
      \uD1B5\uD574 \uC5D4\uC9C4\uC744 \uC81C\uC678\uD55C \uBAA8\uB4E0 UI\uB97C \n\uC81C\uAC70
